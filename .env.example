# Copy to .env and fill in. Never commit .env.

# Required. Admin key for /admin/* and ingestion (at least 24 characters). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Passwords for the local compose services (any value, they are bound to 127.0.0.1)
POSTGRES_PASSWORD=nordcart
RABBITMQ_PASSWORD=nordcart

# Host ports (change if they clash with something already running)
DB_HOST_PORT=5443
REDIS_HOST_PORT=6390
RABBIT_HOST_PORT=5673
RABBIT_UI_HOST_PORT=15673
API_HOST_PORT=8010

# Connections. Only used when you run the app outside Docker (uvicorn, celery or pytest on
# your machine); docker compose sets its own values for the containers.
DATABASE_URL=postgresql+psycopg://nordcart:nordcart@localhost:5443/nordcart
REDIS_URL=redis://localhost:6390/0
CELERY_BROKER_URL=amqp://nordcart:nordcart@localhost:5673//
CELERY_RESULT_BACKEND=redis://localhost:6390/1
# true = run Celery tasks inline instead of sending them to RabbitMQ (tests, one-off scripts)
CELERY_EAGER=false

# Tunables
# How long a cached dashboard lives.
CACHE_TTL_SECONDS=300
# How long one request may hold the single-flight lock while it computes a missed entry.
CACHE_LOCK_SECONDS=20
# Longest date range a single dashboard request may ask for.
MAX_RANGE_DAYS=366
# How often Celery beat looks for sellers with unprocessed new data.
BEAT_INTERVAL_SECONDS=60

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
