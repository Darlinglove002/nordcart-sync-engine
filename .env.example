# Copy to .env and fill in. Never commit .env.

# Required. Admin key for /admin/* and ingestion. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Passwords for the local compose services (any value, they are bound to 127.0.0.1)
POSTGRES_PASSWORD=nordcart
RABBITMQ_PASSWORD=nordcart

# Host ports (change if they clash with something already running)
DB_HOST_PORT=5443
REDIS_HOST_PORT=6390
RABBIT_HOST_PORT=5673
RABBIT_UI_HOST_PORT=15673
API_HOST_PORT=8010

# Tunables
CACHE_TTL_SECONDS=300
